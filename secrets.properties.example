# Copy this file to secrets.properties (same directory). Copied as it is, it builds an
# UNCONFIGURED app: every relay value below is empty, so the app opens on its
# "Connect to your relay" screen and you type the values on the phone. Fill a value
# in here only to have it baked into your own build instead.
# secrets.properties is git-ignored. The file and every key are optional: a missing or
# empty key becomes an empty BuildConfig field (the build prints one warning per key) and
# the app asks for that value in its Relay settings instead.
# Values are read by app/build.gradle.kts and exposed to the app as BuildConfig fields,
# so whatever you put here is compiled into the APK as plain text: never share that APK.

# Shared secret that must match IMSG_TOKEN on the relay; sent as the X-Imsg-Token header
# (HTTP requests and the WebSocket upgrade alike; never placed in a URL). Plain ASCII only.
# Example: IMSG_TOKEN=the-same-long-random-string-as-on-the-relay
IMSG_TOKEN=

# Cloudflare Access service-token client id (CF-Access-Client-Id header) for the tunnel in
# front of the relay. Only for a relay behind Cloudflare Access: set both CF keys or neither.
# Example: CF_ACCESS_CLIENT_ID=0123456789abcdef0123456789abcdef.access
CF_ACCESS_CLIENT_ID=

# Cloudflare Access service-token client secret (CF-Access-Client-Secret header).
# Example: CF_ACCESS_CLIENT_SECRET=the-client-secret-cloudflare-showed-once
CF_ACCESS_CLIENT_SECRET=

# The app is tunnel-only: it always reaches the relay through its HTTPS address,
# at home too. There is deliberately no LAN address here: a private address
# reached over cleartext http would hand the relay token and both Cloudflare
# Access credentials to whatever answers at that address on another network.
# The build fails unless the two URLs below, when set, are https:// and wss:// on
# the same host (and port), with no query string; credentials are sent to that origin only.

# Relay HTTPS base URL (a Cloudflare Tunnel hostname or a Tailscale Serve name), no trailing
# slash. Must be https://.
# Example: RELAY_REMOTE_BASE=https://relay.example.com
RELAY_REMOTE_BASE=

# Relay WebSocket URL. Must be wss:// on the same host and port as RELAY_REMOTE_BASE; no query
# string. Left empty, the app derives it from RELAY_REMOTE_BASE (wss://<host>[:port]<path>/ws).
# Example: RELAY_REMOTE_WS=wss://relay.example.com/ws
RELAY_REMOTE_WS=

# Full https:// URL (query string and #fragment allowed) of the family map page the Map
# button opens in a WebView. Empty hides the button.
# Example: FAMILY_MAP_URL=https://relay.example.com/map
FAMILY_MAP_URL=

# Which optional features the app starts with, comma-separated from: facetime, map, translate, voice.
# This line being present makes it authoritative: exactly the names listed start ON (an empty value
# means all OFF); an unknown name is ignored with a build warning. With the line absent, all four start
# ON when RELAY_REMOTE_BASE is set and OFF otherwise (and only that last build — no FEATURES line, no
# RELAY_REMOTE_BASE — takes its first values from the relay's /health, once). Each switch can be changed
# later in the app's Settings > Features.
# Example: FEATURES=translate,voice
FEATURES=

# Launcher label — also the title of the chat list and the "Unlock …" lock prompt. Optional, and
# commented out here: when the key is absent the app is labelled "SelfBubbles". Any one line of text
# up to 30 characters (an empty value is ignored, a longer one is cut to 30 and a line break becomes
# a space, each with a build warning). It is a resource (R.string.app_name), not a BuildConfig field.
# APP_LABEL=SelfBubbles

# Application id — the id the app is installed under on the phone (not its label). Optional, and
# commented out here: when the key is absent the app installs as "io.github.avtraang.selfbubbles".
# Set it only to keep installing over an app that is already on your phone under another id (to Android
# a different id is a different app, with its own data, settings and notification channels), or to match
# the package name your own Firebase client file (app/google-services.json) was created for. At least
# two segments separated by dots, each starting with a letter and made of letters, digits and
# underscores only, or the build fails naming the key; so does a google-services.json with no client
# for the id. An empty value (APPLICATION_ID=) is rejected too: to use the default, leave the line
# commented out or delete it. The Kotlin package stays io.github.avtraang.selfbubbles whatever you
# put here.
# APPLICATION_ID=io.github.avtraang.selfbubbles
