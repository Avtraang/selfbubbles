<?xml version="1.0" encoding="utf-8"?>
<!-- Direct share targets: every dynamic conversation shortcut the app publishes
     (ConversationShortcuts.kt, category android.shortcut.conversation) shows at
     the top of the system share sheet and sends to ShareActivity with
     EXTRA_SHORTCUT_ID naming the chat. No static shortcuts. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="io.github.avtraang.selfbubbles.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="android.shortcut.conversation" />
    </share-target>
</shortcuts>
