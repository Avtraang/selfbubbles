<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices below API 31 (newer ones read
   data_extraction_rules.xml). The relay token and the Cloudflare Access pair
   live in SharedPreferences "relay_config" once saved in Settings,
   "app_prefs" holds the app-lock and shortcut settings, and "outbox" holds the
   texts not yet delivered to the relay (Outbox.kt); none of them may leave the
   phone in a cloud backup. The backup agent keys shared_prefs by file name.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="relay_config.xml" />
    <exclude domain="sharedpref" path="app_prefs.xml" />
    <exclude domain="sharedpref" path="outbox.xml" />
</full-backup-content>
