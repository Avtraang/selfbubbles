<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+. The relay token and the
   Cloudflare Access pair live in SharedPreferences "relay_config" once saved in
   Settings, "app_prefs" holds the app-lock and shortcut settings, and "outbox"
   holds the texts not yet delivered to the relay (Outbox.kt: message text, chat
   identifiers and names); none of them may leave the phone in a cloud backup
   or ride a device-to-device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="relay_config.xml" />
        <exclude domain="sharedpref" path="app_prefs.xml" />
        <exclude domain="sharedpref" path="outbox.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="relay_config.xml" />
        <exclude domain="sharedpref" path="app_prefs.xml" />
        <exclude domain="sharedpref" path="outbox.xml" />
    </device-transfer>
</data-extraction-rules>
